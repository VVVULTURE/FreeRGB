<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreeRGB.App.MainWindow"
        Title="FreeRGB" Width="980" Height="660" MinWidth="760" MinHeight="520"
        Icon="avares://FreeRGB/Assets/icon.png" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse x:Name="BackendDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- profile bar -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
        <Button x:Name="RescanBtn" Content="Rescan" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Profile" VerticalAlignment="Center" />
        <ComboBox x:Name="ProfileBox" Width="180" />
        <Button x:Name="SaveProfileBtn" Content="Save" />
        <Button x:Name="NewProfileBtn" Content="Save as…" />
        <Button x:Name="DeleteProfileBtn" Content="Delete" />
        <Button x:Name="ImportBtn" Content="Import…" />
        <Button x:Name="ExportBtn" Content="Export…" />
      </StackPanel>
    </DockPanel>

    <TabControl x:Name="Tabs">
      <!-- ============ Lights ============ -->
      <TabItem Header="Lights" x:Name="LightsTab">
        <Grid ColumnDefinitions="260,12,*" Margin="0,8,0,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="All devices" FontWeight="SemiBold" />
                <TextBlock Text="Sets a static colour on every controllable device." Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox x:Name="AllHex" Text="#FFFFFF" Width="100" />
                  <Button x:Name="AllApplyBtn" Content="Apply" />
                  <Button x:Name="AllOffBtn" Content="All off" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ListBox x:Name="DeviceList" />
          </DockPanel>

          <ScrollViewer Grid.Column="2">
            <StackPanel x:Name="ControlPanel" Spacing="12" Margin="0,0,8,0">
              <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Opacity="0.8" />
              <StackPanel x:Name="DeviceHeader" Spacing="2">
                <TextBlock x:Name="DevTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="DevSub" Opacity="0.7" />
                <Border x:Name="DevWarning" IsVisible="False" Padding="10" CornerRadius="6" Background="#33FFAA00" Margin="0,6,0,0">
                  <TextBlock x:Name="DevWarningText" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="Controls" Spacing="12">
                <ToggleSwitch x:Name="PowerSwitch" OnContent="Lighting on" OffContent="Lighting off" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Effect" />
                  <ComboBox x:Name="EffectBox" MinWidth="260" />
                </StackPanel>
                <Expander x:Name="ZoneExpander" Header="Zones" IsVisible="False" IsExpanded="True">
                  <StackPanel x:Name="ZoneList" Spacing="6" Margin="0,6,0,0" />
                </Expander>
                <StackPanel x:Name="ColorPanel" Spacing="6">
                  <TextBlock Text="Colour" />
                  <ColorView x:Name="Picker" IsAlphaVisible="False" IsColorSpectrumVisible="True" IsColorPaletteVisible="False" IsColorComponentsVisible="True" IsColorModelVisible="False" IsHexInputVisible="False" Width="300" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Hex" VerticalAlignment="Center" />
                    <TextBox x:Name="HexBox" Width="110" MaxLength="7" />
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="BrightnessPanel" Spacing="4">
                  <TextBlock x:Name="BrightnessLabel" Text="Brightness" />
                  <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                </StackPanel>
                <StackPanel x:Name="SpeedPanel" Spacing="4">
                  <TextBlock x:Name="SpeedLabel" Text="Speed" />
                  <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Width="360" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============ Diagnostics ============ -->
      <TabItem Header="Diagnostics" x:Name="DiagTab">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <Button x:Name="DiagRefreshBtn" Content="Refresh" />
            <Button x:Name="DiagCopyBtn" Content="Copy to clipboard" />
          </StackPanel>
          <TextBox x:Name="DiagText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" TextWrapping="NoWrap" />
        </DockPanel>
      </TabItem>

      <!-- ============ Settings ============ -->
      <TabItem Header="Settings" x:Name="SettingsTab">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left">
            <CheckBox x:Name="StartWithOsBox" Content="Start FreeRGB when I sign in (minimised to the tray)" />
            <TextBlock x:Name="StartupNote" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
            <CheckBox x:Name="StartMinBox" Content="When started at sign-in, don't open the window" />
            <CheckBox x:Name="CloseToTrayBox" Content="Closing the window keeps FreeRGB running in the tray (use the tray menu → Exit to quit)" />
            <Separator />
            <TextBlock Text="Hardware setup" FontWeight="SemiBold" />
            <TextBlock x:Name="SetupStatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="SetupExplain" TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                       Text="One click: downloads OpenRGB 1.0 (hash-checked), installs the PawnIO driver (needed only for RAM and motherboard SMBus lighting; downloaded from its author, hash-checked) and registers a start-up task so OpenRGB runs without a prompt each time. Windows asks for administrator permission once." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SetupBtn" Content="Set up hardware support" />
              <ProgressBar x:Name="SetupBusy" IsIndeterminate="True" IsVisible="False" Width="120" />
            </StackPanel>
            <TextBlock x:Name="SetupLog" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
            <Separator />
            <TextBlock Text="OpenRGB (hardware backend)" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="FreeRGB controls hardware through OpenRGB's local SDK server (127.0.0.1 only). OpenRGB must be installed and its SDK server running." />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Port" VerticalAlignment="Center" />
              <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" Value="6742" FormatString="0" Width="130" />
            </StackPanel>
            <CheckBox x:Name="AutoLaunchBox" Content="Start OpenRGB for me (headless server mode) if it isn't running" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox x:Name="OpenRgbPathBox" Width="420" PlaceholderText="Path to OpenRGB executable" />
              <Button x:Name="BrowseOpenRgbBtn" Content="Browse…" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Effect frame rate cap" VerticalAlignment="Center" />
              <NumericUpDown x:Name="FpsBox" Minimum="5" Maximum="60" Value="20" FormatString="0" Width="130" />
            </StackPanel>
            <Button x:Name="SaveSettingsBtn" Content="Save settings" HorizontalAlignment="Left" />
            <TextBlock x:Name="SettingsNote" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
